#!/bin/sh
export QT_QPA_PLATFORM=wayland
export QT_QUICK_BACKEND=rhi
export QSG_RHI_BACKEND=opengl
export QT_SCALE_FACTOR=1.5

if [ -f /var/lib/kiosk/desktop-mode ]; then
    /usr/bin/banks-frontend &
    TERM_BIN=matchbox-terminal
    [ -f /var/lib/kiosk/terminal ] && TERM_BIN=$(cat /var/lib/kiosk/terminal)
    case "$TERM_BIN" in
        matchbox-terminal) exec matchbox-terminal -e /etc/kiosk/kiosk-login-shell ;;
        *) exec weston-terminal --maximized --shell=/etc/kiosk/kiosk-login-shell ;;
    esac
else
    exec /usr/bin/banks-frontend --kiosk
fi
