[Unit]
Description=Bind-mount persistent data over volatile paths
After=local-fs.target data.mount
Requires=data.mount
Before=bluetooth.service sshd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/bin/mountpoint -q /data
ExecStart=/usr/sbin/banks-persist-bind

[Install]
WantedBy=multi-user.target
