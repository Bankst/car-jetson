#!/bin/sh
# Bind-mount persistent data from /data over volatile rootfs paths.
# Copies current rootfs state into /data on first run so nothing is lost.
set -eu

bind_dir() {
    local src="$1" dst="$2"
    [ -d "$src" ] || mkdir -p "$src"
    [ -d "$dst" ] || mkdir -p "$dst"
    # Seed persistent copy from rootfs if empty
    if [ -z "$(ls -A "$src" 2>/dev/null)" ]; then
        cp -a "$dst"/. "$src"/ 2>/dev/null || true
    fi
    mount --bind "$src" "$dst"
}

bind_file() {
    local src="$1" dst="$2"
    # Seed from rootfs if persistent copy doesn't exist
    if [ ! -f "$src" ] && [ -f "$dst" ]; then
        cp -a "$dst" "$src"
    fi
    [ -f "$src" ] || return 0
    mount --bind "$src" "$dst"
}

bind_dir /data/bluetooth /var/lib/bluetooth

# Persist SSH host keys only — not sshd_config (that comes from rootfs)
mkdir -p /data/ssh
for key in /etc/ssh/ssh_host_*; do
    [ -f "$key" ] || continue
    bind_file "/data/ssh/$(basename "$key")" "$key"
done
