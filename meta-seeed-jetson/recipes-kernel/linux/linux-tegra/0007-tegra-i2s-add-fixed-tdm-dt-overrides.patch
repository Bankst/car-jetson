From: Gemini CLI <gemini@google.com>
Subject: [PATCH] ASoC: tegra210-i2s: add fixed TDM configuration via DT

--- a/nvidia/sound/soc/tegra-alt/tegra210_i2s_alt.c	2026-06-10 03:02:04.332037958 -0400
+++ b/nvidia/sound/soc/tegra-alt/tegra210_i2s_alt.c	2026-06-10 03:02:04.343711712 -0400
@@ -1063,6 +1063,7 @@
 	struct property *prop;
 	void __iomem *regs;
 	int ret = 0, count = 0, num_supplies;
+	unsigned int val;
 	const char *supply;
 
 	match = of_match_device(tegra210_i2s_of_match, &pdev->dev);
@@ -1145,6 +1146,20 @@
 			}
 		}
 	}
+	if (of_property_read_u32(np, "nvidia,audio-channels",
+				 &val) == 0) {
+		i2s->audio_ch_override[I2S_RX_PATH] = val;
+		i2s->audio_ch_override[I2S_TX_PATH] = val;
+		i2s->client_ch_override = val;
+	}
+
+	if (of_property_read_u32(np, "nvidia,sample-size",
+				 &val) == 0) {
+		/* 16 or 32 bits */
+		i2s->audio_fmt_override[I2S_RX_PATH] = (val == 32) ? 2 : 1;
+		i2s->audio_fmt_override[I2S_TX_PATH] = (val == 32) ? 2 : 1;
+	}
+
 	pm_runtime_enable(&pdev->dev);
 	ret = snd_soc_register_codec(&pdev->dev, &tegra210_i2s_codec,
 				     tegra210_i2s_dais,
