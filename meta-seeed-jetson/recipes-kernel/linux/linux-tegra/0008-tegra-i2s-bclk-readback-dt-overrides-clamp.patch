From: Banks Troutman <banks.troutman@oxos.com>
Date: Tue, 10 Jun 2026 00:00:00 +0000
Subject: [PATCH] ASoC: tegra210-i2s: BCLK rate readback, DT overrides, bit_count clamp

Three fixes for TDM audio on Tegra194:

1. Read back actual BCLK rate after clk_set_rate in set_timing_params.
   BPMP firmware may round up (e.g. I2S5 max_rate constraint gives
   24.576 MHz instead of requested 12.288 MHz). Using the actual rate
   for bit_count computation ensures correct LRCK framing regardless
   of clock divider granularity.

2. Read nvidia,audio-channels and nvidia,sample-size DT properties in
   probe to override the I2S channel count and format. Without this,
   the DPCM C2C link negotiates 2ch/S16 and BCLK/LRCK are wrong for
   TDM codecs.

3. Clamp bit_count to the register mask instead of returning -EINVAL.
   When BPMP gives a higher-than-requested clock rate, bit_count can
   exceed the mask but the hardware still functions correctly with the
   clamped value.

---
--- a/sound/soc/tegra/tegra210_i2s.c
+++ b/sound/soc/tegra/tegra210_i2s.c
@@ -778,6 +778,11 @@
 		return err;
 	}
 
+	/* Use actual clock rate for bit_count — BPMP may round up due to
+	 * divider constraints. With doubled BCLK, TDM slots are wider but
+	 * data stays left-justified; codecs read valid bits, ignore padding. */
+	bclk_rate = clk_get_rate(i2s->clk_i2s);
+
 	regmap_read(i2s->regmap, TEGRA210_I2S_CTRL, &val);
 
 	/*
@@ -803,8 +808,9 @@
 	}
 
 	if (bit_count > I2S_TIMING_CH_BIT_CNT_MASK) {
-		dev_err(dev, "invalid I2S channel bit count %u\n", bit_count);
-		return -EINVAL;
+		dev_warn(dev, "I2S bit count %u exceeds mask, clamping\n",
+			 bit_count);
+		bit_count = I2S_TIMING_CH_BIT_CNT_MASK;
 	}
 
 	regmap_write(i2s->regmap, TEGRA210_I2S_TIMING,
@@ -1240,6 +1246,20 @@
 
 	regcache_cache_only(i2s->regmap, true);
 
+	{
+		unsigned int v;
+		if (of_property_read_u32(dev->of_node, "nvidia,audio-channels", &v) == 0) {
+			i2s->audio_ch_override[I2S_RX_PATH] = v;
+			i2s->audio_ch_override[I2S_TX_PATH] = v;
+			i2s->client_ch_override = v;
+		}
+		if (of_property_read_u32(dev->of_node, "nvidia,sample-size", &v) == 0) {
+			i2s->audio_fmt_override[I2S_RX_PATH] = (v == 32) ? 2 : 1;
+			i2s->audio_fmt_override[I2S_TX_PATH] = (v == 32) ? 2 : 1;
+			i2s->client_fmt_override = (v == 32) ? 2 : 1;
+		}
+	}
+
 	err = devm_snd_soc_register_component(dev, &tegra210_i2s_cmpnt,
 					      tegra210_i2s_dais,
 					      ARRAY_SIZE(tegra210_i2s_dais));
