[Unit]
Description=Lock I2S5 clock to 12.288MHz (256xFs) after pipewire settles
# Must run AFTER pipewire/wireplumber have opened their initial stream: that
# first I2S5 hw_params calls clk_set_rate(12288000), which the BPMP rounds UP
# to 24.576MHz (512xFs) and which the CS42448 TDM codec cannot frame. We force
# it back to 256xFs and lock it. Forcing it earlier (sysinit / before pipewire)
# does not stick — the clock tree isn't configured yet and/or pipewire's first
# stream re-rounds it. See docs/cs42448-audio-state-2026-06-10.md.
After=pipewire.service wireplumber.service sound.target banks-audio-route.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 8
ExecStart=/bin/sh -c "for i in 1 2 3; do echo 0 > /sys/kernel/debug/bpmp/debug/clk/i2s5/mrq_rate_locked; echo 12288000 > /sys/kernel/debug/bpmp/debug/clk/i2s5/rate; echo 1 > /sys/kernel/debug/bpmp/debug/clk/i2s5/mrq_rate_locked; sleep 1; done; echo i2s5 locked at $(cat /sys/kernel/debug/bpmp/debug/clk/i2s5/rate) Hz"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
