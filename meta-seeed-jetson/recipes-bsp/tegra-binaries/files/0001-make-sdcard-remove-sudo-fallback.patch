From: Banks Troutman <banks.troutman@oxos.com>
Subject: make-sdcard: remove sudo fallback for unprivileged flash

Run as the invoking user — fail with EPERM instead of silently
escalating. User must have disk group access to the block device.

--- a/make-sdcard.sh
+++ b/make-sdcard.sh
@@ -12,8 +12,6 @@
 HAVEBMAPTOOL=

 SUDO=
-[ $(id -u) -eq 0 ] || SUDO="sudo"
-
 usage() {
     cat <<EOF

